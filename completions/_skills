#compdef skills skills.sh skr ske skcr skcd skt skl

typeset -ga _skills_subcommands=(
  'sync:Symlink SOURCE skills into each TARGET/skills directory'
  'unsync:Remove TARGET/skills symlinks that point at SOURCE skills'
)

typeset -ga _skills_sync_options=(
  '--install-githooks[Install sync logic into local git hooks and configure core.hooksPath]::hook names:_skills_git_hook_names'
  '(-h --help)'{-h,--help}'[Show help]'
)

typeset -ga _skills_target_alias_specs=(
  'claude:Alias for .claude'
  'gemini:Alias for .gemini'
  'codex:Alias for .codex'
  'pi:Alias for .pi/agent'
  'antigravity:Alias for .antigravity'
)

typeset -ga _skills_git_hook_values=(
  applypatch-msg
  pre-applypatch
  post-applypatch
  pre-commit
  pre-merge-commit
  prepare-commit-msg
  commit-msg
  post-commit
  pre-rebase
  post-checkout
  post-merge
  pre-push
)

source "${${(%):-%x}:A:h}/_pi_skill_completion"

_skills() {
  case "${words[1]}" in
    (skr|ske|skcd|skt|skl) _skills_complete_access_command; return $? ;;
    (skcr) _skills_complete_flags_only; return $? ;;
    (skills|skills.sh) ;;
    (*) return 1 ;;
  esac

  local curcontext="$curcontext" state line
  local -i ret=1
  typeset -A opt_args

  _arguments -C \
    '1: :->subcommand' \
    '*:: :->args' && ret=0

  case $state in
    (subcommand)
      _describe -t subcommands 'skills commands' _skills_subcommands && ret=0
      ;;
    (args)
      case $line[1] in
        (sync)
          _skills:sync
          ret=$?
          ;;
        (unsync)
          _skills:unsync
          ret=$?
          ;;
        (*)
          _message 'skills command'
          ret=0
          ;;
      esac
      ;;
  esac

  return $ret
}

_skills:sync() {
  _arguments -A '-*' -s -S \
    "${_skills_sync_options[@]}" \
    '1:source parent directory:_skills_source_directory' \
    '2:target directories:_skills_target_directories' && return 0
}

_skills:unsync() {
  _arguments -A '-*' -s -S \
    '1:source parent directory:_skills_source_directory' \
    '2:target directories:_skills_target_directories' && return 0
}

_skills_source_directory() {
  _files -/
}

_skills_target_directories() {
  compset -P '*,'
  _alternative \
    'aliases:convenience target:_skills_target_aliases' \
    'directories:target directory:_skills_target_paths'
}

_skills_target_aliases() {
  _describe -t aliases 'convenience target' _skills_target_alias_specs -S ,
}

_skills_target_paths() {
  _files -/ -S ,
}

_skills_git_hook_names() {
  _values -s , 'git hook' "${_skills_git_hook_values[@]}"
}

_skills_complete_access_options() {
  local expl
  local -a option_names option_displays

  option_names=(-g -p)
  option_displays=(
    '-g -- Use only global skills and plugins'
    '-p -- Select provider (default: agents)'
  )

  _description options expl option
  compadd "$expl[@]" -d option_displays -a option_names
}

_skills_complete_access_providers() {
  local -a provider_specs=(
    'agents:Shared skills and plugins (default)'
    'pi:Pi skills directory'
    'claude:Claude skills directory'
    'codex:Codex skills directory'
    'gemini:Gemini skills directory'
    'antigravity:Antigravity skills directory'
  )

  _describe -t providers 'provider' provider_specs
}

_skills_complete_skill_file_paths() {
  emulate -L zsh
  local is_global="$1" provider="$2" skill_name="$3" target_root="" file_path=""
  local -a relative_file_paths
  local expl

  _skills_load_runtime_helpers || return 1
  _skills_resolve_scope "$is_global" "$provider" 2>/dev/null || return 1
  _skills_resolve_target "$skill_name" "${reply[@]}" completion 2>/dev/null || return 1
  target_root="${reply[2]}"

  _skills_collect_paths "${reply[@]:2}"
  for file_path in "${reply[@]}"; do
    [[ -f "$file_path" ]] && relative_file_paths+=("${file_path#"$target_root"/}")
  done
  (( ${#relative_file_paths} )) || return 1

  _description files expl 'skill or plugin file'
  compadd "$expl[@]" -a relative_file_paths
}

_skills_complete_access_command() {
  emulate -L zsh
  local current_word="${words[CURRENT]-}" previous_word="${words[CURRENT-1]-}"
  local is_global="false" provider="" skill_name="" relative_file_path=""
  local -i max_positionals=1
  local -a completed_arguments

  if [[ "$previous_word" == -p ]]; then
    _skills_complete_access_providers
    return $?
  fi

  if [[ "$current_word" == -* ]]; then
    _skills_complete_access_options
    return $?
  fi

  [[ "${words[1]}" == skr ]] && max_positionals=2
  (( CURRENT > 2 )) && completed_arguments=("${(@)words[2,CURRENT-1]}")
  _skills_load_runtime_helpers || return 1
  _skills_parse_access_arguments completion "$max_positionals" "${completed_arguments[@]}" 2>/dev/null || return 1
  is_global="${reply[1]}"
  provider="${reply[2]}"
  skill_name="${reply[3]-}"
  relative_file_path="${reply[4]-}"

  if [[ -z "$skill_name" ]]; then
    _pi_skill_completion "$is_global" "$provider"
    return $?
  fi

  [[ "${words[1]}" == skr && -z "$relative_file_path" ]] || return 1
  _skills_complete_skill_file_paths "$is_global" "$provider" "$skill_name"
}

_skills_complete_flags_only() {
  emulate -L zsh
  local current_word="${words[CURRENT]-}" previous_word="${words[CURRENT-1]-}"

  if [[ "$previous_word" == "-p" ]]; then
    _skills_complete_access_providers
    return $?
  fi

  if [[ "$current_word" == -* ]]; then
    _skills_complete_access_options
    return $?
  fi
}

if [ "${funcstack[1]}" = "_skills" ]; then
  _skills "$@"
else
  compdef _skills skills skills.sh skr ske skcr skcd skt skl
fi
