#compdef pi

_pi() {
  local curcontext="$curcontext" state line
  local -i ret=1
  typeset -A opt_args

  local -a root_options=(
    '--provider[Provider name (default: google)]:name:_pi_providers'
    '--model[Model pattern or ID]:pattern:_pi_model_ids'
    '--api-key[API key]:key:_default'
    '--system-prompt[System prompt]:text:_default'
    '*--append-system-prompt[Append text or file contents to the system prompt]:text:_default'
    '--mode[Output mode]:mode:(text json rpc)'
    '(-p --print)'{-p,--print}'[Non-interactive mode: process prompt and exit]'
    '(-c --continue)'{-c,--continue}'[Continue previous session]'
    '(-r --resume)'{-r,--resume}'[Select a session to resume]'
    '--session[Use specific session file or partial UUID]:path-or-id:_pi_session_reference'
    '--session-id[Use exact project session ID, creating it if missing]:id:_default'
    '--fork[Fork a specific session file or partial UUID into a new session]:path-or-id:_pi_session_reference'
    '--session-dir[Directory for session storage and lookup]:dir:_files -/'
    '--no-session[Do not save the session]'
    '(-n --name)'{-n,--name}'[Set session display name]:name:_default'
    '--models[Comma-separated model patterns for Ctrl+P cycling]:patterns:_pi_models_patterns'
    '(-nt --no-tools)'{-nt,--no-tools}'[Disable all tools by default (built-in and extension)]'
    '(-nbt --no-builtin-tools)'{-nbt,--no-builtin-tools}'[Disable built-in tools by default but keep extension/custom tools enabled]'
    '(-t --tools)'{-t,--tools}'[Comma-separated allowlist of tool names to enable]:tools:_pi_tools'
    '(-xt --exclude-tools)'{-xt,--exclude-tools}'[Comma-separated denylist of tool names to disable]:tools:_pi_tools'
    '--thinking[Set thinking level]:level:(off minimal low medium high xhigh max)'
    '*'{-e,--extension}'[Load an extension file]:path:_files'
    '(-ne --no-extensions)'{-ne,--no-extensions}'[Disable extension discovery (explicit -e paths still work)]'
    '*--skill[Load a skill file or directory]:path:_files'
    '(-ns --no-skills)'{-ns,--no-skills}'[Disable skills discovery and loading]'
    '*--prompt-template[Load a prompt template file or directory]:path:_files'
    '(-np --no-prompt-templates)'{-np,--no-prompt-templates}'[Disable prompt template discovery and loading]'
    '*--theme[Load a theme file or directory]:path:_files'
    '--use-theme[Set the initial interactive theme for this run]:name:_pi_theme_names'
    '--no-themes[Disable theme discovery and loading]'
    '(-nc --no-context-files)'{-nc,--no-context-files}'[Disable AGENTS.md and CLAUDE.md discovery and loading]'
    '--export[Export a session file to HTML and exit]:file:_files'
    '--list-models[List available models, optionally filtered by fuzzy search]::search:_default'
    '--verbose[Force verbose startup]'
    '--tui-mode[TUI mode]:mode:(regular fullscreen)'
    '(-a --approve -na --no-approve)'{-a,--approve}'[Trust project-local files for this run]'
    '(-a --approve -na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this run]'
    '--offline[Disable startup network operations]'
    '(-h --help)'{-h,--help}'[Show help]'
    '(-v --version)'{-v,--version}'[Show version number]'
  )

  # Registered by installed extensions, so this list tracks the local install.
  local -a extension_options=(
    '--fff-mode[FFF mode]:mode:(tools-and-ui tools-only override)'
    '--fff-frecency-db[Path to the frecency database]:path:_files'
    '--fff-history-db[Path to the query history database]:path:_files'
    '--fff-enable-root-scan[Allow indexing when launched from the filesystem root]'
    '--fff-enable-home-scan[Index the home dir when launched from $HOME]'
    '--mcp-config[Path to MCP config file]:path:_files'
  )

  local -a subcommands=(
    'install:Install extension source and add it to settings'
    'remove:Remove extension source from settings'
    'uninstall:Alias for remove'
    'update:Update pi, extensions, or model catalogs'
    'list:List installed extensions from settings'
    'config:Open TUI to enable or disable package resources'
    'auth:Print credentials or check provider readiness'
  )

  _arguments -A '-*' -C -s -S \
    "${root_options[@]}" \
    "${extension_options[@]}" \
    '1: :->root_arg' \
    '*:: :->root_rest' && ret=0

  case $state in
    (root_arg)
      if [[ $words[CURRENT] == @* ]]; then
        _pi_at_file
        ret=$?
      else
        _describe -t subcommands 'pi commands' subcommands && ret=0
      fi
      ;;
    (root_rest)
      case $line[1] in
        (install)
          _pi:install
          ret=$?
          ;;
        (remove|uninstall)
          _pi:remove
          ret=$?
          ;;
        (update)
          _pi:update
          ret=$?
          ;;
        (list)
          _pi:list
          ret=$?
          ;;
        (config)
          _pi:config
          ret=$?
          ;;
        (auth)
          _pi:auth
          ret=$?
          ;;
        (*)
          if [[ $words[CURRENT] == @* ]]; then
            _pi_at_file
            ret=$?
          else
            _arguments -A '-*' -C -s -S \
              "${root_options[@]}" \
              "${extension_options[@]}" && ret=0
          fi
          ;;
      esac
      ;;
  esac

  return $ret
}

_pi:install() {
  local -a options=(
    '(-l --local)'{-l,--local}'[Install project-locally (.pi/settings.json)]'
    '(-a --approve -na --no-approve)'{-a,--approve}'[Trust project-local files for this command]'
    '(-a --approve -na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]'
    '(-h --help)'{-h,--help}'[Show help for install]'
  )

  _arguments -A '-*' -s -S \
    "${options[@]}" \
    '1:source:_pi_package_source' && return 0
}

_pi:remove() {
  local -a options=(
    '(-l --local)'{-l,--local}'[Remove from project settings (.pi/settings.json)]'
    '(-a --approve -na --no-approve)'{-a,--approve}'[Trust project-local files for this command]'
    '(-a --approve -na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]'
    '(-h --help)'{-h,--help}'[Show help for remove or uninstall]'
  )

  _arguments -A '-*' -s -S \
    "${options[@]}" \
    '1:source:_pi_installed_sources' && return 0
}

_pi:update() {
  local -a options=(
    '(--extensions --models --all --extension)--self[Update pi only (default when no target is given)]'
    '(--self --models --all --extension)--extensions[Update installed packages only]'
    '(--self --extensions --all --extension)--models[Refresh model catalogs only]'
    '(--self --extensions --models --extension)--all[Update pi and installed packages]'
    '(--self --extensions --models --all)--extension[Update one package only]:source:_pi_installed_sources'
    '(-a --approve -na --no-approve)'{-a,--approve}'[Trust project-local files for this command]'
    '(-a --approve -na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]'
    '--force[Reinstall pi even if the current version is latest]'
    '(-h --help)'{-h,--help}'[Show help for update]'
  )

  _arguments -A '-*' -C -s -S \
    "${options[@]}" \
    '1::target:_pi_update_targets' \
    '*:: :->rest' && return 0

  case $state in
    (rest)
      _arguments -A '-*' -C -s -S "${options[@]}" && return 0
      ;;
  esac
}

_pi:list() {
  local -a options=(
    '(-a --approve -na --no-approve)'{-a,--approve}'[Trust project-local files for this command]'
    '(-a --approve -na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command]'
    '(-h --help)'{-h,--help}'[Show help for list]'
  )

  _arguments -A '-*' -s -S \
    "${options[@]}" && return 0
}

_pi:config() {
  local -a options=(
    '(-l --local)'{-l,--local}'[Edit project overrides (.pi/settings.json)]'
    '(-a --approve -na --no-approve)'{-a,--approve}'[Trust project-local files for this command with -l]'
    '(-a --approve -na --no-approve)'{-na,--no-approve}'[Ignore project-local files for this command with -l]'
    '(-h --help)'{-h,--help}'[Show help for config]'
  )

  _arguments -A '-*' -s -S \
    "${options[@]}" && return 0
}

_pi:auth() {
  local curcontext="$curcontext" state line
  local -i ret=1

  local -a auth_commands=(
    'print-api-key:Print the resolved API key'
    'print-bearer-token:Print an OAuth bearer token, refreshing it when expired'
    'check:Report whether a provider is ready to use'
  )

  local -a target_options=(
    '--provider[Provider name]:name:_pi_providers'
    '--model[Model pattern or ID]:pattern:_pi_model_ids'
    '(-h --help)'{-h,--help}'[Show help for auth]'
  )

  _arguments -A '-*' -C -s -S \
    '(-h --help)'{-h,--help}'[Show help for auth]' \
    '1: :->auth_command' \
    '*:: :->auth_rest' && ret=0

  case $state in
    (auth_command)
      _describe -t auth-commands 'pi auth commands' auth_commands && ret=0
      ;;
    (auth_rest)
      case $line[1] in
        (print-api-key)
          _arguments -A '-*' -s -S "${target_options[@]}" && ret=0
          ;;
        (print-bearer-token)
          _arguments -A '-*' -s -S \
            "${target_options[@]}" \
            '--min-expiry[Require this much remaining token lifetime]:duration:(30s 1m 5m 30m 1h)' && ret=0
          ;;
        (check)
          _arguments -A '-*' -s -S \
            "${target_options[@]}" \
            '--json[Emit the report as JSON]' \
            '--credentials[Emit the credential, or include it in JSON output]' \
            '--no-refresh[Do not refresh expired OAuth credentials]' && ret=0
          ;;
      esac
      ;;
  esac

  return $ret
}

_pi_at_file() {
  compset -P '@'
  _files
}

_pi_installed_sources() {
  local line source
  local -a sources

  while IFS= read -r line; do
    [[ $line == '  '* ]] || continue
    [[ $line == '    '* ]] && continue

    source=${line#  }
    source=${source% \(filtered\)}
    sources+=("$source")
  done < <(pi list 2>/dev/null)

  (( ${#sources[@]} )) || return 1
  sources=(${(u)sources})
  _describe -t sources 'installed package sources' sources
}

_pi_update_targets() {
  _alternative \
    'targets:special target:(self pi)' \
    'sources:installed package source:_pi_installed_sources'
}

_pi_package_source() {
  case $PREFIX in
    (./*|../*|/*|~*)
      _files -/
      ;;
    (*)
      _message 'extension source'
      ;;
  esac
}

_pi_session_reference() {
  case $PREFIX in
    (./*|../*|/*|~*|*/*|*.jsonl)
      _pi_session_files
      ;;
    (*)
      _pi_session_ids
      ;;
  esac
}

_pi_resolve_agent_dir() {
  if [[ -n ${PI_CODING_AGENT_DIR-} ]]; then
    REPLY=${PI_CODING_AGENT_DIR}
    return 0
  fi

  REPLY='~/.pi/agent'
}

_pi_resolve_session_dir() {
  if [[ -n ${opt_args[--session-dir]-} ]]; then
    REPLY=${opt_args[--session-dir]}
    return 0
  fi

  if [[ -n ${PI_CODING_AGENT_SESSION_DIR-} ]]; then
    REPLY=${PI_CODING_AGENT_SESSION_DIR}
    return 0
  fi

  _pi_resolve_agent_dir
  REPLY="${REPLY}/sessions"
}

_pi_session_id_lines() {
  local session_dir session_file session_name session_id
  local -a session_files

  _pi_resolve_session_dir
  session_dir="$REPLY"
  session_files=(${~session_dir}/**/*.jsonl(N))

  for session_file in $session_files; do
    session_name=${session_file:t:r}
    [[ $session_name == *_* ]] || continue
    session_id=${session_name##*_}
    print -r -- "$session_id"
  done
}

_pi_session_ids() {
  local expl
  local -a session_ids

  session_ids=(${(f)"$(_pi_session_id_lines)"})

  (( ${#session_ids[@]} )) || return 1
  session_ids=(${(u)session_ids})
  _wanted session_ids expl 'session id' compadd -a session_ids
}

_pi_session_files() {
  _files -g '*.jsonl'
}

# --use-theme takes one theme name, or 'light-theme/dark-theme' to follow the terminal.
_pi_theme_names() {
  local expl themes_dir
  local -a themes

  _pi_resolve_agent_dir
  themes_dir="${REPLY}/themes"
  themes=(dark light ${~themes_dir}/*.json(N:t:r))

  compset -P '*/'
  themes=(${(u)themes})
  _wanted themes expl 'theme' compadd -a themes
}

_pi_tools() {
  _values -s , 'tool' \
    'read[Read file contents]' \
    'bash[Execute bash commands]' \
    'edit[Edit files with find/replace]' \
    'write[Write files]' \
    'grep[Search file contents]' \
    'find[Find files by glob pattern]' \
    'ls[List directory contents]'
}

