_pi_model_id_lines() {
  local cache_file=/tmp/pi-list-models
  local provider model rest model_id

  if [[ ! -f $cache_file ]]; then
    pi --list-models > "$cache_file" 2>&1
  fi

  while read -r provider model rest; do
    [[ -n $provider && $provider != provider ]] || continue
    [[ -n $model ]] || continue
    model_id="${provider}/${model}"
    print -r -- "$model_id"

    if [[ $model_id == openrouter/* ]]; then
      print -r -- "${model_id#openrouter/}"
    fi
  done < "$cache_file"

  local models_json
  _pi_resolve_agent_dir
  models_json=${~REPLY}/models.json
  if [[ -f $models_json ]]; then
    jq -r '.providers[]?.modelOverrides[]?.name' "$models_json" 2>/dev/null
  fi
}

_pi_model_ids() {
  local expl
  local -a models

  models=(${(f)"$(_pi_model_id_lines)"})

  (( ${#models[@]} )) || return 1
  models=(${(u)models})
  _wanted models expl 'model id' compadd -a models
}

_pi_models_patterns() {
  local -a models

  models=(${(f)"$(_pi_model_id_lines)"})
  (( ${#models[@]} )) || return 1

  models=(${(u)models})
  _values -s , 'model id' "${models[@]}"
}

if [ "${funcstack[1]}" = "_pi" ]; then
  _pi "$@"
else
  compdef _pi pi
fi
