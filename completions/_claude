      ;;
  esac
}

_claude:auto-mode() {
  local -a auto_mode_subcommands=(
    'config:Print the effective auto mode config as JSON'
    'critique:Get AI feedback on your custom auto mode rules'
    'defaults:Print the default auto mode environment, allow, and deny rules as JSON'
    'help:display help for command'
    'reset:Reset auto mode configuration to the shipped defaults'
  )

  _arguments -C \
    '1: :->auto_mode_subcommand' \
    '*:: :->auto_mode_args' && ret=0

  case ${state} in
    (auto_mode_subcommand)
      if (( CURRENT == 2 )); then
        _describe -t subcommands 'auto-mode subcommands' auto_mode_subcommands && ret=0
      fi
      ;;
    (auto_mode_args)
      case ${words[1]} in
        (config)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help for command]' && ret=0
          ;;
        (critique)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '--model=[Override which model is used]:model:(fable opus sonnet haiku)' && ret=0
          ;;
        (defaults)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '--label=[Show only rules whose label starts with this prefix]:prefix:' && ret=0
          ;;
        (reset)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '(-y --yes)'{-y,--yes}'[Skip the confirmation prompt]' && ret=0
          ;;
        (help)
          _describe -t subcommands 'auto-mode subcommands' auto_mode_subcommands && ret=0
          ;;
        (*)
          _message "argument for ${words[1]}"
          ;;
      esac
      ;;
  esac
}

_claude:project() {
  local -a project_subcommands=(
    'help:display help for command'
    'purge:Delete all Claude Code state for a project'
  )

  _arguments -C \
    '1: :->project_subcommand' \
    '*:: :->project_args' && ret=0

  case ${state} in
    (project_subcommand)
      if (( CURRENT == 2 )); then
        _describe -t subcommands 'project subcommands' project_subcommands && ret=0
      fi
      ;;
    (project_args)
      case ${words[1]} in
        (purge)
          _arguments \
            '(1)--all[Purge state for every project]' \
            '--dry-run[List what would be deleted without deleting anything]' \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '(-i --interactive)'{-i,--interactive}'[Prompt for each item before deleting]' \
            '(-y --yes)'{-y,--yes}'[Skip confirmation prompt]' \
            '(--all)1::path:_files -/' && ret=0
          ;;
        (help)
          _describe -t subcommands 'project subcommands' project_subcommands && ret=0
          ;;
        (*)
          _message "argument for ${words[1]}"
          ;;
      esac
      ;;
  esac
}

_claude:ultrareview() {
  _arguments \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '--json[Print the raw bugs.json payload instead of formatted findings]' \
    '(--post)--no-post[Do not post the findings to the PR]' \
    '(--no-post)--post[Post the finished review findings to the PR as you]' \
    '--timeout=[Maximum minutes to wait for the review to finish]:minutes:' \
    '1:target:' && return 0
}

