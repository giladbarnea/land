#compdef claude
# Created 2026-01-27

_claude() {
  local curcontext="$curcontext" state line
  local -i ret=1
  typeset -A opt_args

  local -a main_options=(
    '--add-dir=[Additional directories to allow tool access to]:directory:_files -/'
    '--agent=[Agent for the current session]:agent:'
    '--agents=[JSON object defining custom agents, or with --print a file that holds one]:json-or-file:_files'
    '--allow-dangerously-skip-permissions[Enable bypassing permission checks as an option]'
    '--allowedTools=[Comma or space-separated list of tool names to allow]:tools:'
    '--allowed-tools=[Comma or space-separated list of tool names to allow]:tools:'
    '--append-system-prompt=[Append a system prompt to the default]:prompt:'
    '--autocompact=[Auto-compact window size (auto, or 100k-1M tokens)]:size:(auto)'
    '--ax-screen-reader[Render screen-reader friendly output]'
    '(--bg --background)'{--bg,--background}'[Start the session in the background and return immediately]'
    '--bare[Minimal mode: skip hooks, LSP, plugin sync, etc.]'
    '--betas=[Beta headers to include in API requests]:betas:'
    '--brief[Enable SendUserMessage tool for agent-to-user communication]'
    '--chrome[Enable Claude in Chrome integration]'
    '--cloud=[Create a cloud session, or attach to one by session ID or URL]::description, session id or url:'
    '(-c --continue)'{-c,--continue}'[Continue the most recent conversation in the current directory]'
    '--dangerously-skip-permissions[Bypass all permission checks]'
    '(-d --debug)'{-d,--debug=}'[Enable debug mode with optional category filtering]:filter:'
    '--debug-file=[Write debug logs to a specific file path]:path:_files'
    '--disable-slash-commands[Disable all skills]'
    '--disallowedTools=[Comma or space-separated list of tool names to deny]:tools:'
    '--disallowed-tools=[Comma or space-separated list of tool names to deny]:tools:'
    '--effort=[Effort level for the current session]:level:(low medium high xhigh max)'
    '--environment=[Create a cloud session on a self-hosted environment]:environment id:'
    '--exclude-dynamic-system-prompt-sections[Move per-machine sections into the first user message]'
    '--fallback-model=[Comma-separated fallback models when the default is unavailable]:model:(fable opus sonnet haiku)'
    '--file=[File resources to download at startup]:specs:'
    '--fork-session[Create a new session ID when resuming]'
    '--forward-subagent-text[Forward subagent text and thinking blocks as messages]'
    '--from-pr=[Resume a session linked to a PR by PR number/URL]:value:'
    '(-h --help)'{-h,--help}'[Display help for command]'
    '--ide[Automatically connect to IDE on startup]'
    '--include-hook-events[Include all hook lifecycle events in the output stream]'
    '--include-partial-messages[Include partial message chunks as they arrive]'
    '--input-format=[Input format]:format:(text stream-json)'
    '--json-schema=[JSON Schema for structured output validation]:schema:'
    '--max-budget-usd=[Maximum dollar amount to spend on API calls]:amount:'
    '--mcp-config=[Load MCP servers from JSON files or strings]:configs:'
    '--model=[Model for the current session]:model:(fable opus sonnet haiku)'
    '(-n --name)'{-n,--name=}'[Set a display name for this session]:name:'
    '--no-chrome[Disable Claude in Chrome integration]'
    '--no-session-persistence[Disable session persistence]'
    '--output-format=[Output format]:format:(text json stream-json)'
    '--permission-mode=[Permission mode to use for the session]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)'
    '--permission-prompts=[Who answers permission prompts with --print]:target:(host none)'
    '--plugin-dir=[Load a plugin from a directory or .zip for this session only]:path:_files'
    '--plugin-url=[Fetch a plugin .zip from a URL for this session only]:url:'
    '(-p --print)'{-p,--print}'[Print response and exit]'
    '--prompt-suggestions=[Enable prompt suggestions]::value:(true false 1 0 yes no on off)'
    '--remote-control=[Start an interactive session with Remote Control enabled]::name:'
    '--remote-control-session-name-prefix=[Prefix for auto-generated Remote Control session names]:prefix:'
    '--replay-user-messages[Re-emit user messages from stdin]'
    '--restricted[Remove code-running tools and ignore user, project and local settings]'
    '(-r --resume)'{-r,--resume=}'[Resume a conversation by session ID]:value:'
    '--safe-mode[Start with all customizations disabled]'
    '--session-id=[Use a specific session ID]:uuid:'
    '--setting-sources=[Comma-separated list of setting sources]:sources:'
    '--settings=[Path to a settings JSON file or a JSON string]:file-or-json:_files'
    '--strict-mcp-config[Only use MCP servers from --mcp-config]'
    '--system-prompt=[System prompt to use for the session]:prompt:'
    '--system-prompt-snapshot=[Record the system prompt once per conversation]:mode:(on off)'
    '--teleport=[Resume a teleport session]::session:'
    '--tmux=[Create a tmux session for the worktree]::mode:(classic)'
    '--tools=[Specify the list of available tools]:tools:'
    '--verbose[Override verbose mode setting from config]'
    '(-v --version)'{-v,--version}'[Output the version number]'
    '(-w --worktree)'{-w,--worktree=}'[Create a new git worktree for this session]:name:'
  )

  local -a subcommands=(
    'agents:Manage background agents'
    'attach:Open a background session in this terminal'
    'auth:Manage authentication'
    'auto-mode:Inspect or reset auto mode classifier configuration'
    'doctor:Check the health of your Claude Code installation'
    'gateway:Run the enterprise auth/telemetry gateway'
    'import:Import config from another AI coding agent'
    'install:Install Claude Code native build'
    'kill:Stop a background session'
    'logs:Print recent terminal output of a background session'
    'mcp:Configure and manage MCP servers'
    'plugin:Manage Claude Code plugins'
    'plugins:Manage Claude Code plugins'
    'project:Manage Claude Code project state'
    'respawn:Restart a background session so it runs the current version'
    'rm:Delete a background session and its worktree'
    'setup-token:Set up a long-lived authentication token'
    'stop:Stop a background session'
    'ultrareview:Run a cloud-hosted multi-agent code review'
    'update:Check for updates and install if available'
    'upgrade:Check for updates and install if available'
  )

  _arguments -C \
    $main_options \
    '1: :->subcommand' \
    '*:: :->args' && ret=0

  case $state in
    (subcommand)
      if (( CURRENT == 2 )); then
        _describe -t subcommands 'claude subcommands' subcommands && ret=0
      fi
      ;;
    (args)
      case "${words[1]}" in
        (agents)
          _claude:agents
          ret=$?
          ;;
        (attach|logs|stop|kill)
          _arguments \
            '1:session:_claude_background_sessions' && ret=0
          ;;
        (auth)
          _claude:auth
          ret=$?
          ;;
        (auto-mode)
          _claude:auto-mode
          ret=$?
          ;;
        (doctor)
          _message "no arguments"
          ret=0
          ;;
        (gateway)
          _arguments \
            '--config=[Path to gateway YAML config]:path:_files' \
            '(-h --help)'{-h,--help}'[Display help for command]' && ret=0
          ;;
        (import)
          _arguments \
            '--dry-run[Show what would be imported without writing anything]' \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '--yes[Skip the interactive picker]' \
            '1::source:(codex gemini cursor)' && ret=0
          ;;
        (install)
          _claude:install
          ret=$?
          ;;
        (mcp)
          _claude:mcp
          ret=$?
          ;;
        (plugin|plugins)
          _claude:plugin
          ret=$?
          ;;
        (project)
          _claude:project
          ret=$?
          ;;
        (respawn)
          _arguments \
            '(1)--all[Restart all background sessions]' \
            '(--all)1:session:_claude_background_sessions' && ret=0
          ;;
        (rm)
          _arguments \
            '--discard-unpushed=[Also discard the worktree unpushed commits]:commit@worktree-id:' \
            '--force-remove-worktree=[Delete the worktree directory even if removal failed]:worktree id:' \
            '1:session:_claude_background_sessions' && ret=0
          ;;
        (setup-token)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help for command]' && ret=0
          ;;
        (ultrareview)
          _claude:ultrareview
          ret=$?
          ;;
        (update|upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help for command]' && ret=0
          ;;
        (*)
          ret=0
          ;;
      esac
      ;;
  esac

  return $ret
}

# Background sessions carry a short `id`; `--all` includes exited ones, which `attach` and `rm` accept.
_claude_background_sessions() {
  local -a sessions
  sessions=(${(f)"$(claude agents --json --all 2>/dev/null | jq -r '.[] | select(.kind == "background") | "\(.id):\(.name // .cwd)"')"})
  (( ${#sessions[@]} )) || return 1
  _describe -t sessions 'background session' sessions
}

_claude:install() {
  _arguments \
    '--force[Force installation even if already installed]' \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '1:target:(stable latest)' && return 0
}

