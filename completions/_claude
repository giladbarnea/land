_claude:plugin:eval() {
  local -a eval_options=(
    '--ablation=[Run a no-plugin baseline arm]:mode:(none with-without)'
    '--allow-real-servers[With --mocks record: also start real MCP servers that have no mock]'
    '*--allow-tools=[Operator grant for gated tools]:tools:'
    '--case=[Filter cases by name glob]:glob:'
    '(-j --concurrency)'{-j,--concurrency=}'[Run up to <n> agent runs at once]:n:(1 2 3 4 5 6 7 8)'
    '--eval-dir=[Directory below the plugin that holds the eval cases]:dir:_files -/'
    '(-h --help)'{-h,--help}'[Display help for command]'
    '--json=[Print the full run result as JSON, or write it to a file]::path:_files'
    '--judge-model=[Override LLM-grader model]:model:(fable opus sonnet haiku)'
    '--keep-temp[Preserve scaffold dirs for debugging]'
    '--max-cost-usd=[Hard cost ceiling]:usd:'
    '--mocks=[Mock stand-ins for MCP servers]:mode:(record off)'
    '--model=[Override model for all cases]:model:(fable opus sonnet haiku)'
    '(--publish-report)--no-publish[Keep the HTML report local only]'
    '(--scaffold)--no-scaffold[Explicitly skip scaffold_script]'
    '--output-dir=[Directory for aggregate-result.json]:dir:_files -/'
    '(--no-publish)--publish-report[Also require publishing the report to claude.ai]'
    '--report=[Write the HTML report to this path]:path:_files'
    '--runs=[Override per-case runs]:n:'
    '(--no-scaffold)--scaffold[Run each case scaffold_script]'
    '*--tag=[Filter cases by tag]:tag:'
    '--threshold=[Exit 1 if any case score is below this threshold]:0..1:'
    '--trust-plugin[Skip the first-run trust prompt]'
    '--verbose[Log per-message trace events to the debug log]'
  )

  _arguments -C \
    "${eval_options[@]}" \
    '1: :->eval_target' \
    '*:: :->eval_args' && ret=0

  case ${state} in
    (eval_target)
      _alternative \
        'subcommands:eval subcommand:((init\:"Author an eval suite under the eval dir"))' \
        'targets:plugin path or name:_files -/' && ret=0
      ;;
    (eval_args)
      case ${words[1]} in
        (init)
          _arguments \
            '--bare[Write a blank template instead of running the interview]' \
            '--eval-dir=[Directory to write cases into]:dir:_files -/' \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '(-i --interactive)'{-i,--interactive}'[Run the authoring interview]' \
            '1::name:' && ret=0
          ;;
        (*)
          _arguments "${eval_options[@]}" && ret=0
          ;;
      esac
      ;;
  esac
}

