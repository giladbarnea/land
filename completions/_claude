        _describe -t subcommands 'plugin subcommands' plugin_subcommands && ret=0
      fi
      ;;
    (plugin_args)
      case ${words[1]} in
        (details)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '1:plugin:' && ret=0
          ;;
        (disable)
          _arguments \
            '(-a --all 1)'{-a,--all}'[Disable all enabled plugins]' \
