            '*--config=[Set a userConfig option declared in the plugin manifest]:key=value:' \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '--json[Print one machine-readable result line]' \
            '--registry=[npm registry for a <package>@npm install]:url:' \
            '(-s --scope)'{-s,--scope=}'[Installation scope]:scope:(user project local)' \
