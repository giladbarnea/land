            '(-h --help)'{-h,--help}'[Display help for command]' \
            '--no-browser[Print the authorization URL instead of opening a browser]' \
            '1:name:' && ret=0
          ;;
        (remove)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help for command]' \
            '(-s --scope)'{-s,--scope=}'[Configuration scope]:scope:(local user project)' \
            '1:name:' && ret=0
          ;;
