#compdef llm-commit-msg

_llm-commit-msg() {
  local -a options=(
    '--append-prompt=[Append text to the commit-message prompt]:text:'
    '--one-by-one=-[Process each file individually (default false)]::boolean:(true false)'
  )

  local -i separator_index=${words[(I)--]}
  if (( separator_index && separator_index < CURRENT )); then
    _files
    return
  fi

  _arguments -A '-*' \
    "${options[@]}" \
    '1:separator:(--)'
}

if [[ "${funcstack[1]}" == "_llm-commit-msg" ]]; then
  _llm-commit-msg "$@"
else
  compdef _llm-commit-msg llm-commit-msg
fi
